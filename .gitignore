# APM-managed context. Source of truth is .apm/ (first-party primitives) plus
# apm.yml and apm.lock.yaml (third-party ones); everything below is generated by
# `apm install` and reproducible from them. APM refuses to deploy through a
# symlinked target root, which is why these are real directories rather than the
# symlinks into .agents/ they used to be.
apm_modules/
.claude/
.opencode/agents/
.opencode/skills/
.agents/skills/
.codex/agents/
.codex/skills/
